-- Create a ScreenGui
local screenGui = Instance.new("ScreenGui")
screenGui.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")

-- Create a TextButton
local button = Instance.new("TextButton")
button.Size = UDim2.new(0, 200, 0, 50)
button.Position = UDim2.new(0.5, -100, 0.5, -25)
button.Text = "Change Gravity"
button.Parent = screenGui

-- Function to toggle gravity
local defaultGravity = 196.2
local lowGravity = 50
local currentGravity = defaultGravity

button.MouseButton1Click:Connect(function()
    if currentGravity == defaultGravity then
        currentGravity = lowGravity
        workspace.Gravity = lowGravity
        button.Text = "Gravity: Low"
    else
        currentGravity = defaultGravity
        workspace.Gravity = defaultGravity
        button.Text = "Gravity: Normal"
    end
end)